__pycache__/
Testdaten/
.claude/
.venv/
build/
dist/
# Throwaway spec files generated by `pyinstaller main.py` in the
# project root. Anchored with a leading slash so it does not reach the
# committed build definition in packaging/ (see the Deployment section
# of the README), which therefore needs no negation rule.
/*.spec
.idea/
.vscode/
*.egg-info/
# User manual: only the finished PDFs are part of the repository (the
# application opens them via Help -> User Manual, see gui/manual.py).
# Sources, screenshots and the build tools stay local.
doc/manual/*
!doc/manual/ezDAQ_Handbuch.pdf
!doc/manual/ezDAQ_Manual.pdf
tools/build_manual.py
tools/manual_screenshots.py
